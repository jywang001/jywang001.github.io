ventilator-pressure-prediction","replicate":1,"name":"呼吸机压力预测","metric":"dice-hausdorff-combo","direction":"lower","gap_kind":"zero","status":"running","planned":20,"thresholds":null,"baseline_runs":{"n":4,"mean":1.52662,"min":1.52662,"max":1.52662},"arms":{"A":{"status":"running","rounds":20,"baseline":1.52662,"best":1.37276,"gap":0.1008,"wins":3,"ev":{"preliminary_support":2,"not_supported":2,"inconclusive":9,"implementation_mismatch":7},"final":null,"cost":{"calls":100,"prompt":1443474,"completion":202271}},"B":{"status":"running","rounds":19,"baseline":1.52662,"best":0.7677,"gap":0.4971,"wins":13,"ev":{"preliminary_support":7,"not_supported":6,"inconclusive":5,"implementation_mismatch":1},"final":null,"cost":{"calls":80,"prompt":981119,"completion":144727}},"C":{"status":"running","rounds":18,"baseline":1.52662,"best":0.67245,"gap":0.5595,"wins":13,"ev":{"preliminary_support":11,"not_supported":3,"inconclusive":4,"implementation_mismatch":0},"final":null,"cost":{"calls":98,"prompt":1337792,"completion":186379}}}},{"key":"mle-aerial-cactus-identification-1","bench":"mle-bench","task_id":"aerial-cactus-identification","replicate":1,"name":"航拍仙人掌识别","metric":"auc-roc","direction":"higher","gap_kind":"unit","status":"running","planned":20,"thresholds":null,"baseline_runs":{"n":17,"mean":0.98263,"min":0.98263,"max":0.98263},"arms":{"A":{"status":"running","rounds":20,"baseline":0.98263,"best":0.98312,"gap":0.0282,"wins":1,"ev":{"preliminary_support":2,"not_supported":3,"inconclusive":11,"implementation_mismatch":4},"final":null,"cost":{"calls":100,"prompt":1490029,"completion":220675}},"B":{"status":"running","rounds":16,"baseline":0.98263,"best":0.99662,"gap":0.8054,"wins":5,"ev":{"preliminary_support":4,"not_supported":4,"inconclusive":7,"implementation_mismatch":1},"final":null,"cost":{"calls":67,"prompt":703014,"completion":131663}},"C":{"status":"running","rounds":11,"baseline":0.98263,"best":0.99816,"gap":0.8941,"wins":5,"ev":{"preliminary_support":2,"not_supported":2,"inconclusive":4,"implementation_mismatch":3},"final":null,"cost":{"calls":58,"prompt":633836,"completion":115298}}}}],"tasks":{"leaf-classification":{"name":"Leaf 叶片分类","short":"根据叶片形状/纹理特征识别 99 种植物","source":"Kaggle 竞赛（MLE-bench）","input":"990 张叶片样本，每张已提取 margin（边缘）、shape（形状）、texture（纹理）三组各 64 维特征；另有叶片图片。每类训练样本只有个位数。","target":"属于 99 个物种的概率。","metric":"多分类 log loss。","good":"越低越好；随机猜约为 4.6。","baseline":"三组特征标准化 + 多项逻辑回归（不使用图片）。"},"random-acts-of-pizza":{"name":"Random Acts of Pizza 求助帖","short":"预测 Reddit 上的求助帖能否收到陌生人送的披萨","source":"Kaggle 竞赛（MLE-bench）","input":"约 5,700 条 Reddit 求助帖：标题、正文以及发帖时刻的账号统计（账号年龄、发帖数、点赞等）。只能用发帖时刻已知的字段。","target":"该请求最终是否被满足的概率（约 25% 成功）。","metric":"ROC AUC。","good":"越高越好；0.5 为随机。","baseline":"标题 + 正文的 TF-IDF，加上发帖时刻的数值字段，逻辑回归。"},"learning-agency-lab-automated-essay-scoring-2":{"name":"自动作文评分 2.0","short":"给学生议论文自动打 1–6 分","source":"Kaggle 竞赛（MLE-bench）","input":"约 1.7 万篇学生英文议论文全文。","target":"整体评分（1–6 的整数）。","metric":"QWK（二次加权 Kappa，衡量与人工评分的一致性，差得越远惩罚越重）。","good":"越高越好；1 为完全一致，0 相当于随机。","baseline":"词级 TF-IDF + 岭回归，预测值四舍五入到 1–6。"},"nomad2018-predict-transparent-conductors":{"name":"NOMAD 2018 透明导体材料","short":"由晶体结构预测材料的形成能和带隙","source":"Kaggle 竞赛（MLE-bench）","input":"约 2,400 种铝/镓/铟氧化物晶体的表格描述：空间群、各元素比例、晶格常数与角度（另有原子坐标文件）。","target":"两个连续值：每原子形成能（衡量稳定性）和带隙能量（决定是否透明导电）。","metric":"两列各算 RMSLE（对数均方根误差）后取平均。","good":"越低越好；0 为完美预测。","baseline":"梯度提升回归树，只用表格描述（不读原子几何文件）。"},"statoil-iceberg-classifier-challenge":{"name":"Statoil 冰山 / 船只雷达识别","short":"从卫星雷达图像判断目标是冰山还是船","source":"Kaggle 竞赛（MLE-bench）","input":"约 1,600 张 75×75 的双极化雷达图像（两个波段）和雷达入射角。","target":"是冰山的概率。","metric":"log loss（二分类）。","good":"越低越好；全靠猜约为 0.69。","baseline":"LightGBM，只用每个波段的均值/标准差/最大/最小/中位数和入射角。"},"spooky-author-identification":{"name":"Spooky 恐怖小说作者识别","short":"判断一句话出自爱伦·坡、洛夫克拉夫特还是玛丽·雪莱","source":"Kaggle 竞赛（MLE-bench）","input":"约 2 万个英文句子，摘自三位恐怖小说作家的作品。","target":"每句属于三位作者的概率。","metric":"多分类 log loss（对正确作者给出的概率取负对数的平均）。","good":"越低越好；全靠猜（各 1/3）约为 1.10，0 为完全确定且正确。过于自信的错误会被重罚。","baseline":"词级 TF-IDF + 多项逻辑回归。"},"aerial-cactus-identification":{"name":"航拍仙人掌识别","short":"判断 32×32 航拍小图里有没有柱状仙人掌","source":"Kaggle 竞赛（MLE-bench）","input":"约 1.7 万张 32×32 彩色航拍图块。","target":"图中有仙人掌的概率。","metric":"ROC AUC。","good":"越高越好；该题顶尖接近 1.0，CPU 上不用深度网络也能做得不错。","baseline":"默认 LightGBM，直接用原始像素值。"},"s43588-024-00689-2":{"name":"单细胞双模态聚类（Nature 论文复现）","short":"把细胞按 RNA 计数自动分群","source":"NatureBench · Nature Computational Science 2024 论文任务","input":"四个单细胞数据集（cl3、cl5、mop_sc、mop_sn）中每个细胞的两种 RNA 计数矩阵：已剪接（spliced）和未剪接（unspliced）。每个数据集给定要分成几类（K）。","target":"给每个细胞一个整数簇标签；没有任何训练标签，属于无监督聚类。","metric":"ARI（调整兰德指数，衡量聚类与参考细胞类型的一致程度，扣除了随机一致）。每个数据集算 g =（本次 ARI − 论文参照 ARI）/ 参照 ARI，四个取平均得到 mean_g。","good":"mean_g 越高越好；0 表示与论文参照持平，0.1 表示平均比参照高约 10%。cl3/cl5 已接近满分，提升空间主要在两个 mop 数据集。","baseline":"两种计数各自归一化 → 拼接 → PCA 降到 50 维 → KMeans。","split":"没有独立的未见测试集：每轮直接用官方评分器在线反馈 mean_g（NatureBench 协议允许），最终分数就是 20 轮中见过的最好成绩。"},"champs-scalar-coupling":{"name":"CHAMPS 分子标量耦合常数","short":"由分子三维结构预测两原子间的磁相互作用强度","source":"Kaggle 竞赛（MLE-bench）","input":"约 8.5 万个小分子的原子种类与三维坐标，以及待预测的原子对和耦合类型（1JHC、2JHH 等 8 类）。","target":"每个原子对的标量耦合常数（核磁共振谱中的量）。","metric":"按耦合类型分别算 MAE，取对数后再平均（log MAE）。","good":"越低越好，可以为负数；每降低约 0.69 相当于各类误差减半。","baseline":"LightGBM，特征只有耦合类型、两原子元素和原子间距离。"},"mlsp-2013-birds":{"name":"MLSP 2013 鸟鸣识别","short":"判断一段野外录音里出现了哪些鸟","source":"Kaggle 竞赛（MLE-bench）","input":"约 650 段 10 秒野外录音；主办方已提供分段后的声学特征直方图。训练集很小（约 200 段）。","target":"19 种鸟各自出现的概率（一段录音可有多种）。","metric":"ROC AUC（所有录音 × 鸟种整体计算）。","good":"越高越好；验证集只有约 50 段录音，分数抖动较大。","baseline":"每种鸟一个逻辑回归，只用提供的分段直方图（不读音频）。"},"text-normalization-challenge-english-language":{"name":"英文文本规范化","short":"把书面写法改写成朗读写法（如“1995” → “nineteen ninety five”）","source":"Kaggle 竞赛（MLE-bench）","input":"约 1,000 万个英文词元（token），按句子组织。","target":"每个词元的朗读形式；绝大多数词元原样保留。","metric":"词元级准确率（完全一致才算对）。","good":"越高越好；“原样照抄”就能对绝大多数词元，难点在数字、日期、单位等少数类别。","baseline":"查表：每个词元用训练集中最常见的改写，没见过的词元原样输出。"},"ventilator-pressure-prediction":{"name":"呼吸机压力预测","short":"模拟呼吸机：由控制信号预测肺内气压","source":"Kaggle 竞赛（MLE-bench）","input":"约 7.5 万次模拟呼吸，每次 80 个时间步：肺的阻力 R、顺应性 C、吸气阀开度 u_in、呼气阀状态 u_out。","target":"每个时间步的气道压力。","metric":"MAE（平均绝对误差），只在吸气阶段（u_out = 0）的时间步上计算。","good":"越低越好；单位为 cmH2O。顶尖方案靠深度序列模型可低于 0.2，CPU 树模型难以接近。","baseline":"LightGBM 逐时间步回归，特征含同一次呼吸内的 u_in 滞后值和累计值。"},"text-normalization-challenge-russian-language":{"name":"俄文文本规范化","short":"把俄文书面写法改写成朗读写法","source":"Kaggle 竞赛（MLE-bench）","input":"约 1,000 万个俄文词元，按句子组织。","target":"每个词元的朗读形式（俄语数字有格、性变化，比英文更难）。","metric":"词元级准确率。","good":"越高越好；基线已很高，差距在少数难类别。","baseline":"查表：每个词元用训练集中最常见的改写，没见过的词元原样输出。"},"jigsaw-toxic-comment-classification-challenge":{"name":"Jigsaw 有害评论识别","short":"判断维基百科评论是否有毒、侮辱、威胁等 6 类","source":"Kaggle 竞赛（MLE-bench）","input":"约 16 万条维基百科讨论页评论文本。","target":"6 个标签（toxic、severe_toxic、obscene、threat、insult、identity_hate）各自的概率。","metric":"6 个标签各算 ROC AUC 后取平均。","good":"越高越好；该题强基线已在 0.97 以上，剩余空间很小。","baseline":"词级 TF-IDF + 每个标签一个逻辑回归。"},"tabular-playground-series-may-2022":{"name":"Tabular Playground 2022 年 5 月","short":"在合成表格数据上做二分类","source":"Kaggle 练习赛（MLE-bench）","input":"约 90 万行合成制造数据：数十个数值列，外加一个 10 字符的字符串列 f_27（其中隐藏了特征交互）。","target":"二分类标签 target 的概率。","metric":"ROC AUC（随机抽一正一负样本，模型把正样本排得更高的概率）。","good":"越高越好；0.5 为随机，1 为完美排序。","baseline":"默认参数 LightGBM，只用数值列（丢弃字符串列 f_27）。"},"tabular-playground-series-dec-2021":{"name":"Tabular Playground 2021 年 12 月","short":"由地形特征预测森林植被类型","source":"Kaggle 练习赛（MLE-bench）","input":"约 400 万行合成数据，改编自经典“森林覆盖类型”数据集：海拔、坡向、到水源/道路距离、土壤类型等。","target":"7 种植被类型之一（类别极不均衡）。","metric":"分类准确率。","good":"越高越好；强方案之间的差距通常只在千分位。","baseline":"默认参数 LightGBM，只在 100 万行抽样上训练。"},"new-york-city-taxi-fare-prediction":{"name":"纽约出租车车费预测","short":"由上下车地点和时间预测打车费","source":"Kaggle 竞赛（MLE-bench）","input":"约 5,500 万条纽约出租车行程：上/下车经纬度、上车时间、乘客数（含不少脏数据）。","target":"车费（美元）。","metric":"RMSE（均方根误差，单位美元）。","good":"越低越好；例如 3.0 表示典型误差约 3 美元。","baseline":"默认 LightGBM，只用前 200 万行，特征为坐标、直线距离和时间。"}},"limitations":["Not the full ehr-thin runtime; no filesystem/scientific tool agents yet.","Shared initial generation cost is logged once, not charged anew to each arm.","Human waiting time is observed latency, not measured active reading time.","No online model weight updates.","Pinned MLE-bench CPU tasks; one replicate per study, 3 hypotheses per checkpoint.","Official MLE-bench split, grader and leaderboard; per-round feedback is a frozen validation split of public train.","Isolated Python executor with 8 CPU/16 GiB/600 s; not the official 24-hour agent protocol.","Invalid model outputs are re-requested up to three times per stage; every attempt is archived.","One NatureBench task; one replicate per study, one solver seed, 3 hypotheses per checkpoint.","Task-grounded prompt roles and controlled Python executor; not the full ehr-thin/Harbor runtime.","Native online metric feedback is intentionally used for iteration; no independent unseen final test.","Official evaluator/formula are reused, but official validity judge and full resource protocol are not run.","No five-dimensional scientific score. Single-seed control/intervention comparisons are preliminary."]}